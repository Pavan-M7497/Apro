# Supabase project credentials
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Comma-separated profile UUIDs allowed to reach /admin/import.
# Example: VITE_ADMIN_PROFILE_IDS=11111111-1111-1111-1111-111111111111,22222222-2222-2222-2222-222222222222
# Leave blank to lock everyone out. Note this only hides the UI — it is not
# access control; the import tables still need a server-side role check.
VITE_ADMIN_PROFILE_IDS=
